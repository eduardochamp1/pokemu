{
  "name": "pokemu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench-emulador.mjs",
    "sprites": "node scripts/fetch-sprites.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "gen3:species": "node scripts/gen3-species.mjs",
    "gen3:save-check": "node scripts/gen3-save-check.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win portable --x64",
    "desktop:test": "node --test desktop/files.test.mjs",
    "desktop:smoke": "electron . --smoke-test",
    "save:check": "node scripts/save-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "@thenick775/mgba-wasm": "2.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "main": "desktop/main.mjs",
  "description": "Emulador de Game Boy, Game Boy Color e Game Boy Advance",
  "author": "Pokemu",
  "build": {
    "appId": "com.pokemu.desktop",
    "productName": "Pokemu",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.mjs",
      "desktop/files.mjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/logo512.png",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Pokemu-0.1.0-Windows.exe"
    },
    "compression": "store"
  }
}
